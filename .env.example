# 复制为 .env 后按需修改。.env 不入库（见根目录 .gitignore），生产环境使用部署平台的密钥管理。

# MySQL root 口令（必填）
MYSQL_ROOT_PASSWORD=

# 应用数据库与账号（应用账号不使用 root，见 docs/DATABASE.md 9）
MYSQL_DATABASE=verinex
MYSQL_USER=verinex
MYSQL_PASSWORD=

# web 服务映射到宿主机的端口
WEB_PORT=8081

# sitemap 与 canonical 使用的公开站点根地址；生产环境必须改为 HTTPS 正式域名
SITE_PUBLIC_BASE_URL=http://localhost:8081

# 仅适用于本地首次启动。生产环境设为 false，并在备份、审查和人工确认后执行迁移。
DATABASE_INITIALIZE_ON_STARTUP=true

# Cloudflare Tunnel 使用宿主机 ~/.cloudflared 下的本地管理隧道配置（verinex.yml + 凭证 JSON），
# 由 docker-compose 只读挂载，无需在此配置 Token。
